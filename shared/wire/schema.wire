# Marque wire schema. Grammar: shared/wire/README.md.
# Regenerate with scripts/wiregen.sh after any edit.

handle PlayerId
handle NpcId
handle ItemId
handle NodeId

# Range and precision are placeholders until ARM-362 measures them.
quant pos min -4096 max 4096 per_unit 100
quant wish min -1 max 1 per_unit 100

enum RefuseReason {
  unknown_ability = 1
  no_target = 2
  wrong_target = 3
  insufficient_mana = 4
  out_of_range = 5
  cooldown = 6
  dead = 7
}

message input = 1 on input c2s {
  dx wish
  dz wish
  jump bool
  seq u32
}

message pose = 2 on state s2c {
  id PlayerId
  x pos
  y pos
  z pos
}

message hp = 3 on state s2c {
  id PlayerId
  hp u32
  max_hp u32
}

message refused = 4 on events s2c {
  tick u32
  seq u32
  reason RefuseReason
}
