# A client delivers a state section only when its stamp is newer than every
# stamp delivered before. Events in a stale datagram are still delivered.
endpoint client 0123456789abcdef 4800 1024 262144 200000 plain 0 0 0 0
recv 10000 4d525131efcdab89674523010000ffff0000000001050000000100020205
> unreliable 5 0205
recv 20000 4d525131efcdab89674523010100ffff0000000001030000000100020203020100000000010104
> stale
> reliable 04
recv 30000 4d525131efcdab89674523010200ffff0000000001050000000100020205
> stale
recv 40000 4d525131efcdab89674523010300ffff00000000020100010000010105
> reliable 05
recv 50000 4d525131efcdab89674523010400ffff0000000001060000000100020206
> unreliable 6 0206
