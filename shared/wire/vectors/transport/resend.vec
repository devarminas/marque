# A server's event is lost. It is due again ResendAfter after it was sent,
# goes out in a new packet, and once that packet is acked it is never sent
# again.
endpoint server 0123456789abcdef 4800 1024 200000 0
send 04010203
flush 40000
> datagram 4d525131efcdab89674523010000ffff00000000020100000000010404010203
flush 80000
flush 200000
> datagram 4d525131efcdab89674523010100ffff00000000
flush 240000
> datagram 4d525131efcdab89674523010200ffff00000000020100000000010404010203
recv 280000 4d525131efcdab89674523010000020000000000
flush 440000
> datagram 4d525131efcdab89674523010300000000000000
flush 480000
