# A server queues a 65536-byte event and a 1-byte event under an 80000-byte
# budget. The first fills the 65536-byte window, so the second waits until the
# first is acked.
endpoint server 0123456789abcdef 80000 1024 262144 200000 plain 0 0 0 0
send 
send 0402
flush 40000
