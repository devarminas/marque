# A server with the session seal (overhead 24) and the keys in transport.md.
# Its keepalive is 44 bytes. A client datagram sealed with nonce 0 delivers;
# the same datagram again, and a copy with one ack byte changed, are malformed.
endpoint server 0123456789abcdef 4800 1024 262144 200000 session 0 0 0 0
flush 100000
> datagram 4d525131efcdab89674523010000ffff000000000000000000000000c385124ab326469c2a1d1a9439f5700f
send 0401
flush 140000 1 0201
> datagram 4d525131efcdab89674523010100ffff0000000001000000000000001342b66d0375358bc17b4092ea96986419dd6de4df4ea6c0d86e40ab8225548be50af764
> unreliable_sent 1
recv 150000 4d525131efcdab8967452301000000000100000000000000000000001bb94231ade7a6d012655d61af434e26fab4f2234ec1bb314c7e78680fe94812239862
> error malformed
recv 150001 4d525131efcdab8967452301000001000100000000000000000000001bb94231ade7a6d012655d61af434e26fab4f2234ec1bb314c7e78680fe94812239862
> unreliable 1 01
> reliable 0501
recv 150002 4d525131efcdab8967452301000001000100000000000000000000001bb94231ade7a6d012655d61af434e26fab4f2234ec1bb314c7e78680fe94812239862
> error malformed
