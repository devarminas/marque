# Packet sequences wrap from 65535 to 0. A repeat is a duplicate, and a
# sequence more than 32 behind the newest is too old; exactly 32 behind is
# accepted. The flush shows the ack window: latest 1, bits 0x80000007 for 0,
# 65535, 65534, and 65505.
endpoint client 0123456789abcdef 4800 1024 200000 0
recv 10000 4d525131efcdab8967452301feffffff00000000010100000001000102
> unreliable 1 02
recv 20000 4d525131efcdab8967452301ffffffff00000000010200000001000102
> unreliable 2 02
recv 30000 4d525131efcdab89674523010000ffff00000000010300000001000102
> unreliable 3 02
recv 40000 4d525131efcdab89674523010100ffff00000000010400000001000102
> unreliable 4 02
recv 50000 4d525131efcdab8967452301ffffffff00000000020100000000010104
> error duplicate
recv 60000 4d525131efcdab8967452301e0ffffff00000000020100000000010104
> error too_old
recv 70000 4d525131efcdab8967452301e1ffffff00000000020100000000010104
> reliable 04
flush 120000
> datagram 4d525131efcdab89674523010000010007000080
